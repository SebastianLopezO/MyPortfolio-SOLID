---
import "@/styles/globals.css";
import {withBase} from "@/lib/base";

interface Props {
    lang: string;
    /** The page's title, description, canonical, alternates, social tags and structured data, from lib/seo. */
    head: string;
    robots?: string;
    /** The islands that hydrate once the page has settled; <html data-hydrated> appears when all of them have. */
    islands?: string;
    /** The id of what closes the first screen: the page is not painted, nor faded into, before it has been parsed. */
    firstScreen?: string;
}

const {lang, head, robots = "index, follow, max-image-preview:large", islands = "", firstScreen} = Astro.props;

// Pins the theme the reader chose with the header's button before the first paint, so a dark page never flashes white;
// without a choice the page follows the system (tokens.css, light-dark()). The CSP allows it by its SHA-256 hash
// (nginx/security-headers.conf), so its text must stay exactly as it is, whitespace included.
const THEME_SCRIPT = `try {
        var theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme
    } catch (e) {
    }`;

// Starts fetching a page of the site when the pointer rests on its link or presses it, so the page that fades in is
// already there; a browser without speculation rules ignores them. Files (a resume, a certificate, an image), links
// that open another tab and jumps within the page are left out. The link is prefetched as written, and a click may add
// the role view (?from=, lib/role-links.ts) or the lock; the pages say with No-Vary-Search (nginx) that those change
// nothing, so the prefetched page still serves the visit. The CSP names this block by its hash too.
const SPECULATION_RULES = JSON.stringify({
    prefetch: [{
        where: {
            and: [
                {href_matches: "/*"},
                {not: {href_matches: "/*.*"}},
                {not: {selector_matches: "[download], [target=_blank], [href^='#']"}},
            ],
        },
        eagerness: "moderate",
        expects_no_vary_search: "params=(\"from\" \"locked\")",
    }],
});
---
<!doctype html>
<html lang={lang}>
<head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="#fbfcfd" name="theme-color" media="(prefers-color-scheme: light)">
    <meta content="#0d0d0d" name="theme-color" media="(prefers-color-scheme: dark)">
    <meta content="light dark" name="color-scheme">
    <meta content={robots} name="robots">
    <meta content="Sebastián López Osorno" name="author">
    <link href={withBase("/favicon.ico")} rel="icon" sizes="any">
    <link href={withBase("/icon.svg")} rel="icon" type="image/svg+xml">
    <link href={withBase("/apple-touch-icon.png")} rel="apple-touch-icon">
    <script is:inline set:html={THEME_SCRIPT}></script>
    {firstScreen && <link rel="expect" href={`#${firstScreen}`} blocking="render">}
    <script is:inline type="speculationrules" set:html={SPECULATION_RULES}></script>
    <Fragment set:html={head}/>
</head>
<body>
<div id="root" data-islands={islands || undefined}>
    <slot/>
</div>
</body>
</html>
