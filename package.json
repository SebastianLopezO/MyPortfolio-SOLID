{
  "name": "my-portfolio-solid",
  "private": true,
  "version": "4.0.0",
  "description": "Bilingual portfolio of Sebastián López Osorno, built with Astro and SolidJS islands",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build.ts",
    "preview": "node scripts/serve-dist.mjs",
    "lint": "eslint .",
    "typecheck": "astro check --tsconfig tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:links": "node scripts/check-links.mjs",
    "images": "node scripts/optimize-images.mjs",
    "metrics": "node scripts/github-stats.ts",
    "mockups": "node scripts/render-mockups.mjs",
    "og": "node scripts/generate-og.mjs",
    "resumes": "node scripts/render-resumes.mjs"
  },
  "dependencies": {
    "@astrojs/solid-js": "^7.1.0",
    "@fontsource/dm-serif-text": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.1",
    "astro": "~7.3.8",
    "solid-js": "~1.9.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@eslint/js": "^10.0.1",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/tabler": "^1.2.42",
    "@playwright/test": "1.64.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.9.9",
    "eslint": "^10.13.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^4.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
